def generate_key(n):
    letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    key = {}
    count = 0;
    for c in letters:
        key[c] = letters[(count + n) % len(letters)]
        count += 1
    return key

def get_decryption_key(key):
    dkey = {}
    for c in key:
        dkey[key[c]] = c
    return dkey

# decrypts and encrypt a message using encryption/decryption key
def endecrypt(key, text):
    cipher = ""
    for c in text:
        if c in key:
            cipher += key[c]
        else:
            cipher += c
    return cipher



